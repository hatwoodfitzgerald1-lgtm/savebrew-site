---
// The spool cart glyph, in the kit's icon language (24 grid, 1.75 stroke, square caps): a spool with wound
// thread and a tail; the stitched count sits beside it in the heading band.
interface Props { size?: number; class?: string; }
const { size = 24, class: className = '' } = Astro.props;
---
<svg class:list={['icon', 'icon--spool', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter">
    <path d="M6 4h12M6 20h12"/>
    <path d="M8 4v16M16 4v16"/>
    <path d="M8 8.5l8 1.5M8 11.5l8 1.5M8 14.5l8 1.5"/>
    <path d="M16 17l5 1.5"/>
  </g>
</svg>
